  "name": "helix-codex-profile-dock-sidebar",
  "version": "0.6.0",
  "description": "Local account panel with explicit confirmation and a separate Windows restart worker.",
  "extensions": {
    "com.openai": {
      "requires_local_executor": true,
      "interface": {
        "displayName": "Profile Dock Sidebar (Beta)",
        "logo": "./assets/profile-dock-light.png",
        "logoDark": "./assets/profile-dock-dark.png",
        "composerIcon": "./assets/profile-dock-light.png",
        "composerIconDark": "./assets/profile-dock-dark.png"
      }
    }
  }
}
