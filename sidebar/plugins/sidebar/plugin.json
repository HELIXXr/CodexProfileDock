  "name": "helix-codex-profile-dock-sidebar",
  "version": "0.9.0-beta.1",
  "description": "Local account panel for Codex Desktop on Windows and macOS.",
  "extensions": {
    "com.openai": {
      "requires_local_executor": true,
      "interface": {
